# ─── Finales de línea: LF en el repo, cada script con el suyo ───
* text=auto eol=lf
*.sh  text eol=lf
*.ps1 text eol=crlf

# ─── Binarios: sin diff ni conversión de finales de línea ───
*.png  binary
*.jpg  binary
*.jpeg binary
*.wasm binary
*.bin  binary

# ─── Estadísticas de lenguajes (GitHub Linguist) ───
# Código generado: no cuenta como propio y se pliega en los diffs
web/src/wasm/**                          linguist-generated=true
web/public/data/**                       linguist-generated=true
crates/astro-core/tests/fixtures/**      linguist-generated=true
package-lock.json                        linguist-generated=true
Cargo.lock                               linguist-generated=true
# Documentación y recursos: fuera de las estadísticas
*.md                                     linguist-documentation=true
web/public/textures/**                   linguist-vendored=true
# Los scripts de arranque sí cuentan
dev.sh                                   linguist-detectable=true
dev.ps1                                  linguist-detectable=true
